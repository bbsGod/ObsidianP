          </navLabel>
          <content src="text/ch010.xhtml#id_05关于-try-catch-finally" />
        </navPoint>
        <navPoint id="navPoint-329">
          <navLabel>
            <text>06、小结</text>
          </navLabel>
          <content src="text/ch010.xhtml#id_06小结-3" />
