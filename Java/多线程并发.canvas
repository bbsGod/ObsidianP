		{"id":"abfe6bc8ed2bebee","type":"text","text":"\ndimp \"SYSDBA/SysDba123\"@127.0.0.1:5236 FILE=\"D:\\WorkTools\\Tools\\002DataStorage\\dm8\\00MisbootDBA\\NACOS.dmp\" LOG=\"D:\\WorkTools\\Tools\\002DataStorage\\imp_nacos.log\" SCHEMAS=NACOS IGNORE_INIT_PARA=2\n","x":-19605,"y":-2106,"width":261,"height":91,"color":"3"},
		{"id":"70723cae43b988ed","type":"text","text":"\nCREATE SCHEMA \"NACOS\" AUTHORIZATION  \"TAISHAN_PRD\"\n","x":-19794,"y":-2360,"width":116,"height":50},
		{"id":"586acfb7386dbec6","type":"text","text":"-- 1、业务用户 TAISHAN_PRD\nCREATE USER TAISHAN_PRD IDENTIFIED BY \"ZhongtPrd_taishan2020\";\nGRANT DBA, RESOURCE, PUBLIC TO TAISHAN_PRD;\n\n-- 2、nacos专用用户 NACOS\nCREATE USER NACOS IDENTIFIED BY \"ZhongtPrd_taishan2020\";\nGRANT DBA, RESOURCE, PUBLIC TO NACOS;\n\n-- 3、系统初始化 SYSCONFIG\nCREATE USER SYSCONFIG IDENTIFIED BY \"ZhongtPrd_taishan2020\";\nGRANT DBA, RESOURCE, PUBLIC TO SYSCONFIG;\n","x":-19946,"y":-2360,"width":111,"height":50},
