		{"id":"61e3b63c6d0c5c8b","type":"file","file":"Pasted image 20261023173426.png","x":-15597,"y":19533,"width":399,"height":132},
		{"id":"ee04fe7a9383eb95","type":"file","file":"Pasted image 20261023173349.png","x":-16119,"y":19576,"width":400,"height":45},
		{"id":"08be75dc197852f8","type":"file","file":"Pasted image 20261021000135.png","x":-4490,"y":18947,"width":1096,"height":313},
		{"id":"337865468645c1e6","type":"file","file":"Pasted image 20261021000058.png","x":-5910,"y":19078,"width":1079,"height":50},
		{"id":"b247bb8ab1ee5763","type":"text","text":"闭环打通了：B 拿到了还没完工的 A 半成品；A 后面又拿到完工的 B，最后 A 自己完工。","x":-3640,"y":18692,"width":690,"height":50},
		{"id":"7ecd646ffb549dfc","type":"file","file":"Pasted image 20261020235909.png","x":-2707,"y":18669,"width":721,"height":97},
		{"id":"79bd7140ac8b681a","type":"file","file":"Pasted image 20261021151903.png","x":-3244,"y":19028,"width":625,"height":50},
		{"id":"02503e771c7d5786","type":"file","file":"Pasted image 20261021151918.png","x":-3233,"y":19227,"width":1053,"height":67},
		{"id":"6112f2631890dab1","type":"file","file":"Pasted image 20261021151910.png","x":-3244,"y":19128,"width":896,"height":50},
		{"id":"b355a42d42e9a141","type":"text","text":"objectFactory.getObject()","x":-2890,"y":18512,"width":271,"height":50},
		{"id":"44af181c4e3c7c71","type":"text","text":"返回原始半成品 A","x":-2448,"y":18507,"width":250,"height":60},
		{"id":"fc0f143735f48ee4","type":"text","text":"把这个 A 放入二级缓存 earlySingletonObjects","x":-1945,"y":18514,"width":262,"height":53},
		{"id":"cf7eecc1f8e684b9","type":"text","text":"查三级缓存 `singletonFactories`：找到了 A 的 ObjectFactory","x":-3677,"y":18520,"width":622,"height":50},
		{"id":"cca37b776e733804","type":"file","file":"Pasted image 20261027170002.png","x":-1413,"y":17667,"width":787,"height":625},
