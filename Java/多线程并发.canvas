		{"id":"1f55a1b83f5b881b","type":"text","text":"原生 CGLib 代理（目标类**没有接口**）","x":-14418,"y":25078,"width":314,"height":50},
		{"id":"dbbd07d3113b5b37","type":"file","file":"Pasted image 20261028103144.png","x":-16731,"y":25046,"width":463,"height":50},
		{"id":"544f67db81f27038","type":"file","file":"Pasted image 20261023155146.png","x":-8100,"y":26390,"width":400,"height":256},
		{"id":"53535a8801a28d46","type":"text","text":"Enhancer（因 - 汉瑟），> **Enhancer，CGLib 提供专门用来生成目标类子类代理类的工具类**","x":-13991,"y":25020,"width":402,"height":58},
		{"id":"553fbaeba5a5abf7","type":"text","text":"事务","x":-16227,"y":24986,"width":117,"height":50},
		{"id":"f4890de2b9b440df","type":"file","file":"Pasted image 20261028103219.png","x":-16092,"y":24986,"width":649,"height":50},
		{"id":"c1aa5b21d8342c4b","type":"text","text":"// 反射调用真实目标对象的方法 Object result = method.invoke(target, args);","x":-14058,"y":24838,"width":313,"height":78},
		{"id":"111b577d28e80bf9","type":"text","text":"SpringAOP 版本（统一切面，自动选择代理）框架自动判断目标有没有接口，自动选代理实现。","x":-14867,"y":24851,"width":382,"height":55},
		{"id":"39b3f0635aa12bf9","type":"text","text":"Spring AOP 动态代理","x":-15170,"y":24856,"width":205,"height":50},
		{"id":"591313be74e905cf","type":"text","text":"- 调用 `invoke()` 就是标准**反射调用**","x":-13664,"y":24851,"width":319,"height":50},
		{"id":"db9fedd5218e6075","type":"file","file":"Pasted image 20261028102958.png","x":-15867,"y":24650,"width":564,"height":203},
		{"id":"12e77a8b4bcace02","type":"text","text":"InvocationHandler代理对象上**任何方法被调用**，都会自动交给这个 handler 的 `invoke()` 方法执行","x":-14053,"y":24747,"width":448,"height":50},
		{"id":"cae9a90adc0c7c65","type":"text","text":"```\nimport java.lang.reflect.InvocationHandler;\nimport java.lang.reflect.Method;\nimport java.lang.reflect.Proxy;\n\n// ========== 1. 定义接口（JDK代理强制要求必须有接口） ==========\npublic interface UserService {\n    void addUser(String name);\n}\n\n// ========== 2. 目标实现类：实现接口 ==========\npublic class UserServiceImpl implements UserService {\n    @Override\n    public void addUser(String name) {\n        System.out.println(\"【业务】新增用户：\" + name);\n    }\n}\n\n// ========== 3. InvocationHandler：调用处理器，增强逻辑写在这里 ==========\npublic class JdkProxyHandler implements InvocationHandler {\n    // 保存真实目标对象\n    private final Object target;\n\n    // 构造方法注入目标对象\n    public JdkProxyHandler(Object target) {\n        this.target = target;\n    }\n\n    /**\n     * 代理对象执行任何方法，都会进入这个invoke\n     * @param proxy 代理对象本身（一般很少用）\n     * @param method 当前被调用的方法反射对象\n     * @param args 方法入参\n     * @return 方法返回值\n     */\n    @Override\n    public Object invoke(Object proxy, Method method, Object[] args) throws Throwable {\n        // 前置增强：日志、权限、MDC等\n        System.out.println(\"【JDK代理-前置】方法开始：\" + method.getName());\n        // 反射调用真实目标对象的方法\n        Object result = method.invoke(target, args);\n        // 后置增强\n        System.out.println(\"【JDK代理-后置】方法结束：\" + method.getName());\n        return result;\n    }\n\n    // 工具方法：生成代理对象\n    public Object getProxy() {\n        /**\n         * Proxy.newProxyInstance 三个参数：\n         * 1. ClassLoader：类加载器，和目标类保持一致\n         * 2. interfaces：目标实现的接口数组，JDK代理就是基于这些接口生成代理类\n         * 3. InvocationHandler：调用处理器\n         */\n        return Proxy.newProxyInstance(\n                target.getClass().getClassLoader(),\n                target.getClass().getInterfaces(),\n                this\n        );\n    }\n}\n\n// ========== 测试主类 ==========\npublic class JdkProxyTest {\n    public static void main(String[] args) {\n        // 1. 创建真实目标对象\n        UserService target = new UserServiceImpl();\n        // 2. 创建handler，绑定目标\n        JdkProxyHandler handler = new JdkProxyHandler(target);\n        // 3. 获取代理对象\n        UserService proxy = (UserService) handler.getProxy();\n        // 4. 调用代理方法\n        proxy.addUser(\"张三\");\n\n        // 打印类型：代理类是JDK运行时动态生成，不是UserServiceImpl\n        System.out.println(\"代理对象类型：\" + proxy.getClass());\n        // class com.sun.proxy.$Proxy0\n    }\n}\n```","x":-13565,"y":24650,"width":535,"height":147},
		{"id":"c324180ace82ad1b","type":"file","file":"Pasted image 20261028102614.png","x":-16485,"y":24712,"width":532,"height":78},
