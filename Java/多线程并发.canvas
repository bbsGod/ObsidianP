		{"id":"fa7513ce951a796a","type":"text","text":"dminit.exe PATH=\"D:\\WorkTools\\Tools\\002DataStorage\\dm8\\data\" DB_NAME=DMSERVER INSTANCE_NAME=DMSERVER PORT_NUM=5236 PAGE_SIZE=32 EXTENT_SIZE=32 LENGTH_IN_CHAR=1 BLANK_PAD_MODE=0 CASE_SENSITIVE=0 USE_NEW_HASH=1 CHARSET=1 SYSDBA_PWD=\"P@ssW0rd\" SYSAUDITOR_PWD=\"P@ssW0rd\"","x":-19344,"y":-2561,"width":250,"height":62},
		{"id":"d652b4002de6a254","type":"text","text":"\ndmserver.exe D:\\WorkTools\\Tools\\002DataStorage\\dm8\\data\\DMSERVER\\dm.ini\n黑窗口","x":-19469,"y":-2360,"width":250,"height":149},
