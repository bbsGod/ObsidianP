		{"id":"cbd4079e0111e328","type":"text","text":"```\nimport org.aspectj.lang.JoinPoint;\nimport org.aspectj.lang.ProceedingJoinPoint;\nimport org.aspectj.lang.annotation.*;\nimport org.springframework.stereotype.Component;\n\n@Aspect   // ✅ 切面：把切点+通知打包在一起\n@Component\npublic class LogAspect {\n\n    /**\n     * ✅ 切点 Pointcut：筛选规则\n     * execution(* com.example.service.*.*(..))\n     * 含义：匹配service包下所有类、所有方法\n     * 连接点：service包下所有方法（候选），切点从中挑选符合规则的\n     */\n    @Pointcut(\"execution(* com.example.service.*.*(..))\")\n    public void logPointCut(){}\n\n\n    /**\n     * ✅ @Before 前置通知：方法执行之前\n     * JoinPoint：连接点对象，拿到当前被拦截的方法信息\n     */\n    @Before(\"logPointCut()\")\n    public void beforeLog(JoinPoint joinPoint){\n        System.out.println(\"\\n=====【前置通知 @Before】=====\");\n        System.out.println(\"连接点方法名：\" + joinPoint.getSignature().getName());\n        System.out.println(\"方法入参：\" + joinPoint.getArgs());\n    }\n\n    /**\n     * ✅ @After 后置通知：方法执行完毕（不管正常返回还是抛异常都执行）\n     */\n    @After(\"logPointCut()\")\n    public void afterLog(JoinPoint joinPoint){\n        System.out.println(\"=====【后置通知 @After】=====\");\n    }\n\n    /**\n     * ✅ @AfterReturning：方法正常返回后执行，可以拿到返回值\n     */\n    @AfterReturning(value = \"logPointCut()\", returning = \"result\")\n    public void afterReturnLog(JoinPoint joinPoint, Object result){\n        System.out.println(\"=====【返回通知 @AfterReturning】=====\");\n        System.out.println(\"方法返回结果：\" + result);\n    }\n\n    /**\n     * ✅ @AfterThrowing：方法抛出异常的时候执行\n     */\n    @AfterThrowing(value = \"logPointCut()\", throwing = \"ex\")\n    public void afterThrowLog(JoinPoint joinPoint, Exception ex){\n        System.out.println(\"=====【异常通知 @AfterThrowing】=====\");\n        System.out.println(\"异常信息：\" + ex.getMessage());\n    }\n\n    /**\n     * ✅ @Around 环绕通知（最强）\n     * ProceedingJoinPoint 是 JoinPoint 的子类，可以控制是否执行目标方法\n     * 可以在目标方法前后都写逻辑，对应图里的 Extra Logic\n     */\n    @Around(\"logPointCut()\")\n    public Object aroundLog(ProceedingJoinPoint pjp) throws Throwable {\n        System.out.println(\"=====【环绕通知 开始】=====\");\n        long start = System.currentTimeMillis();\n        // 执行目标方法\n        Object res = pjp.proceed();\n        long cost = System.currentTimeMillis() - start;\n        System.out.println(\"=====【环绕通知 结束】方法耗时：\" + cost + \"ms\");\n        return res;\n    }\n}\n```","x":-14997,"y":23695,"width":515,"height":154},
