		{"id":"7e46566c51dd0424","type":"text","text":"\n\nSELECT 'PAGE_SIZE (页大小 KB)' AS 参数名，SF_GET_PAGE_SIZE () AS 值 FROM DUAL                                                                                    \nUNION ALL                                                                                                                                                \nSELECT 'EXTENT_SIZE (簇大小 页数)', SF_GET_EXTENT_SIZE () FROM DUAL                                                                                           \nUNION ALL                                                                                                                                                \nSELECT 'LENGTH_IN_CHAR', SF_GET_LENGTH_IN_CHAR () FROM DUAL                                                                                              \nUNION ALL                                                                                                                                                \nSELECT 'USE_NEW_HASH', SF_GET_PARA_VALUE (2,'USE_NEW_HASH') FROM DUAL                                                                                    \nUNION ALL  \nSELECT PARA_NAME, PARA_VALUE \nFROM V$DM_INI \nWHERE PARA_NAME IN ('BLANK_PAD_MODE')\n                                                                                                                                                                                                                                                                                                   \nUNION ALL                                                                                                                                                \nSELECT 'CASE_SENSITIVE', SF_GET_CASE_SENSITIVE_FLAG () FROM DUAL                                                                                         \nUNION ALL                                                                                                                                                \nSELECT 'UTF-8 标识 ', SF_GET_UNICODE_FLAG () FROM DUAL;                                                                                                    ","x":-18204,"y":-2936,"width":250,"height":62},
