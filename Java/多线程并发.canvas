		{"id":"8eb275e36d0f245b","type":"file","file":"Pasted image 20260908153801.png","x":-15058,"y":-720,"width":539,"height":349},
		{"id":"586acfb7386dbec6","type":"text","text":"-- 1、业务用户 TAISHAN_PRD\nCREATE USER TAISHAN_PRD IDENTIFIED BY \"ZhongtPrd_taishan2020\";\nGRANT DBA, RESOURCE, PUBLIC TO TAISHAN_PRD;\n\n-- 2、nacos专用用户 NACOS\nCREATE USER NACOS IDENTIFIED BY \"ZhongtPrd_taishan2020\";\nGRANT DBA, RESOURCE, PUBLIC TO NACOS;\n\n-- 3、系统初始化 SYSCONFIG\nCREATE USER SYSCONFIG IDENTIFIED BY \"ZhongtPrd_taishan2020\";\nGRANT DBA, RESOURCE, PUBLIC TO SYSCONFIG;\n","x":-15486,"y":860,"width":111,"height":50},
		{"id":"70723cae43b988ed","type":"text","text":"\nCREATE SCHEMA \"NACOS\" AUTHORIZATION  \"TAISHAN_PRD\"\n","x":-15334,"y":860,"width":116,"height":50},
