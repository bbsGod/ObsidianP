		{"id":"5b58dd423160d881","type":"text","text":"\ndimp \"SYSDBA/SysDba123\"@127.0.0.1:5236 FILE=\"D:\\WorkTools\\Tools\\002DataStorage\\dm8\\00MisbootDBA\\Platform.dmp\" LOG=\"D:\\WorkTools\\Tools\\002DataStorage\\imp_nacos.log\" SCHEMAS=PLATFORM IGNORE_INIT_PARA=2\n","x":-15387,"y":1320,"width":250,"height":60},
		{"id":"e28318b82d9fc206","type":"file","file":"Pasted image 20260909112219.png","x":-14433,"y":40,"width":167,"height":169},
		{"id":"7e46566c51dd0424","type":"text","text":"\n\nSELECT 'PAGE_SIZE (页大小 KB)' AS 参数名，SF_GET_PAGE_SIZE () AS 值 FROM DUAL                                                                                    \nUNION ALL                                                                                                                                                \nSELECT 'EXTENT_SIZE (簇大小 页数)', SF_GET_EXTENT_SIZE () FROM DUAL                                                                                           \nUNION ALL                                                                                                                                                \nSELECT 'LENGTH_IN_CHAR', SF_GET_LENGTH_IN_CHAR () FROM DUAL                                                                                              \nUNION ALL                                                                                                                                                \nSELECT 'USE_NEW_HASH', SF_GET_PARA_VALUE (2,'USE_NEW_HASH') FROM DUAL                                                                                    \nUNION ALL  \nSELECT PARA_NAME, PARA_VALUE \nFROM V$DM_INI \nWHERE PARA_NAME IN ('BLANK_PAD_MODE')\n                                                                                                                                                                                                                                                                                                   \nUNION ALL                                                                                                                                                \nSELECT 'CASE_SENSITIVE', SF_GET_CASE_SENSITIVE_FLAG () FROM DUAL                                                                                         \nUNION ALL                                                                                                                                                \nSELECT 'UTF-8 标识 ', SF_GET_UNICODE_FLAG () FROM DUAL;                                                                                                    ","x":-13744,"y":284,"width":250,"height":62},
		{"id":"2927b3e30acebfdc","type":"file","file":"删除_remote_repositories 2.bat","x":-14519,"y":-346,"width":265,"height":53},
