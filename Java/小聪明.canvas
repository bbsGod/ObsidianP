		{"id":"450307417513bed2","x":-2182,"y":2820,"width":115,"height":57,"type":"text","text":"不"},
		{"id":"952bb9f5f07171ee","x":-1820,"y":2820,"width":133,"height":66,"type":"text","text":"做决定"},
		{"id":"70f94c3484b732e6","x":-1814,"y":2660,"width":122,"height":50,"type":"text","text":"扣上帽子"},
		{"id":"1f96d3d0b647070c","x":-2600,"y":3020,"width":232,"height":66,"type":"text","text":"不接受批评、不接受指责"},
		{"id":"3c776d52ccd645eb","x":-2333,"y":3026,"width":233,"height":60,"type":"text","text":"我怎么做，不用你来教我"},
		{"id":"381ee1d2a75cd7ec","x":-2064,"y":3026,"width":257,"height":60,"type":"text","text":"不接受评价，不接受任人拿捏"},
		{"id":"62a43a13c3543037","x":-1744,"y":3026,"width":250,"height":60,"type":"text","text":"我不解决别人的规则"}
	],
