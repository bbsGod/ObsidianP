		{"id":"135a8c4df7684d85","type":"text","text":"肯定自己","x":-2680,"y":2485,"width":119,"height":50},
		{"id":"6d21c051949d8326","type":"text","text":"我自己定义","x":-572,"y":5938,"width":148,"height":61},
		{"id":"8af28f1541aa2762","type":"text","text":"三六九等","x":-2623,"y":5640,"width":125,"height":50},
		{"id":"b1d3e3703d7f0288","type":"text","text":"礼貌","x":-1555,"y":5866,"width":119,"height":50},
		{"id":"bf446967bc4db6c6","type":"text","text":"别人的局限性，认知和我无关，我不负责","x":-1320,"y":6060,"width":250,"height":60},
		{"id":"8f60832cc5bb5cf0","type":"text","text":"价值","x":-789,"y":5841,"width":86,"height":50},
		{"id":"ed343731f1ec2fb9","type":"text","text":"边界","x":-1122,"y":5846,"width":104,"height":50},
		{"id":"9f4964668ff9d6f1","type":"text","text":"不依附","x":-1018,"y":6060,"width":132,"height":60},
		{"id":"c2e9463c30fa8204","type":"text","text":"面对现实、接受自己缺点","x":-340,"y":5999,"width":250,"height":60},
		{"id":"3b3cacf1e6bc7ffd","type":"text","text":"而不是去遮掩，去掩饰，去逃避","x":-333,"y":6152,"width":295,"height":50},
		{"id":"1fd2250a281c34c6","type":"text","text":"按照自己的节奏","x":-298,"y":5836,"width":161,"height":50},
		{"id":"557a3f432379760e","type":"text","text":"我值的","x":-556,"y":6127,"width":116,"height":50},
		{"id":"e91a0252855085ba","type":"text","text":"长幼有序","x":-2623,"y":5766,"width":250,"height":60},
		{"id":"8362552e47b47398","type":"text","text":"戴着枷锁的舞者","x":-2050,"y":5706,"width":179,"height":60},
		{"id":"f5d1183ef9004df9","type":"text","text":"秩序","x":-2858,"y":5520,"width":107,"height":50},
		{"id":"84554b0dff55eadc","type":"text","text":"而不是尊卑臣服","x":-1620,"y":6060,"width":250,"height":60},
		{"id":"eb5abb39da55662c","type":"text","text":"新秩序","x":-1570,"y":5580,"width":250,"height":60},
		{"id":"c5f781a3e18ca9eb","type":"text","text":"等级，排序","x":-817,"y":6004,"width":143,"height":50},
		{"id":"08a815a9c77ff895","type":"text","text":"世人皆醉 我独醒","x":-2086,"y":5510,"width":250,"height":60},
		{"id":"30b6de0639473a0e","type":"text","text":"得不到重视","x":-2198,"y":4951,"width":177,"height":50},
		{"id":"24c7f4e0a54cfcf8","type":"text","text":"区别对待","x":-1802,"y":4940,"width":250,"height":60},
