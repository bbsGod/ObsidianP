		{"id":"e75fcfb0a69f8823","type":"text","text":"解决问题，进步","x":-2408,"y":4310,"width":169,"height":60},
		{"id":"4274613a27545d95","type":"text","text":"逃避痛苦，摆烂了","x":-2405,"y":4170,"width":185,"height":60},
