{
	"nodes":[
		{"id":"2389eb2e255d7ceb","type":"group","x":-3172,"y":1260,"width":2729,"height":2200,"label":"不接受改变"},
		{"id":"fa427dd1f1fee5dc","type":"group","x":-970,"y":-1060,"width":2408,"height":2010,"label":"圆滑世故"},
		{"id":"2fb5745d24a24964","type":"text","text":"期许","x":-2395,"y":1620,"width":120,"height":50},
		{"id":"eb30d08bfb1314eb","type":"text","text":"保守、基础上优化","x":-1990,"y":1833,"width":234,"height":60},
		{"id":"6c5a08c114c6e2f4","type":"text","text":"改掉的叫缺点、改不掉的叫弱点","x":-1600,"y":1830,"width":300,"height":63},
		{"id":"da206316d54b5d2b","type":"text","text":"否定自己，破碎、重组","x":-2006,"y":1620,"width":250,"height":50},
		{"id":"64cd319a63c7bbe6","type":"text","text":"不是改变、而是优化，调整","x":-1509,"y":1726,"width":249,"height":54},
		{"id":"2c661979534f6654","type":"text","text":"面子是可再生资源","x":-2157,"y":2300,"width":179,"height":50},
		{"id":"b224910a7e55ef60","type":"text","text":"底不下下头、拉不下脸","x":-1900,"y":2300,"width":228,"height":50},
		{"id":"4245f47701c1169e","type":"text","text":"高姿态","x":-2017,"y":2420,"width":136,"height":50},
		{"id":"3ab597a109c7b2d1","type":"text","text":"下次再找回来","x":-2289,"y":2402,"width":161,"height":50},
		{"id":"907afb017f5bb1e0","type":"text","text":"难为情","x":-1786,"y":2427,"width":167,"height":50},
		{"id":"d37d58514133d1a0","type":"text","text":"我","x":-2157,"y":1993,"width":57,"height":50},
		{"id":"616b48470ea45196","type":"text","text":"面对不同的人","x":-1900,"y":1993,"width":160,"height":50},
		{"id":"41e7e6abc7d5f442","type":"text","text":"一个猴一个栓法","x":-1600,"y":1993,"width":160,"height":50},
		{"id":"c915a0da4c73577d","type":"text","text":"判断","x":-2425,"y":1993,"width":90,"height":50},
		{"id":"21f46356574bb617","type":"text","text":"盲从、随波逐流","x":-2728,"y":1893,"width":168,"height":60},
		{"id":"954c78db4dd82ebf","type":"text","text":"规划","x":-2780,"y":1998,"width":80,"height":50},
		{"id":"413a7dbcc93b88b5","type":"text","text":"成功只是一个结果、而过程才是选择","x":-3152,"y":1990,"width":250,"height":60},
		{"id":"face12e0885c92dd","type":"text","text":"该驳的面子就得驳","x":-2426,"y":1780,"width":182,"height":50},
		{"id":"15a3b5aee8c96fd5","type":"text","text":"管不了那么多","x":-2360,"y":2140,"width":153,"height":50},
		{"id":"609b9747627ee89a","type":"text","text":"改变自己","x":-2157,"y":1780,"width":125,"height":50},
		{"id":"0c58de74e010f2cb","type":"text","text":"是急从权","x":-2580,"y":2300,"width":123,"height":50},
		{"id":"d29bf17f13892e84","type":"text","text":"哪有什么面面俱到","x":-2381,"y":2300,"width":174,"height":50},
		{"id":"079017eb5635b0d8","type":"text","text":"把自己变成别人期望","x":-2535,"y":1460,"width":200,"height":60},
		{"id":"d8c0caafa2a32922","type":"text","text":"满足别人的规则","x":-2283,"y":1460,"width":183,"height":60},
		{"id":"6f2bbfe24a981672","type":"text","text":"这个过程才是需要是可面、经历的","x":-1621,"y":1382,"width":321,"height":50},
		{"id":"6ebf99a97bc3fb5f","type":"text","text":"难为情、不好意思","x":-2100,"y":2140,"width":183,"height":50},
		{"id":"6693a91bb21ac789","type":"file","file":"Pasted image 20260914135527.png","x":-1850,"y":2580,"width":397,"height":56},
		{"id":"320431447a149bdc","type":"text","text":"你的规则是你的规则，我的规则是我的柜子","x":-2368,"y":1280,"width":353,"height":53},
		{"id":"c240eb30a52d48f0","type":"text","text":"讨论个问题，改变 和 优化调整 那个更适合现在的自己，我接受不了改变，我认为改变这个词是贬义词，是对自己的否定，我会陷入自卑恐惧中，而优化调整是我能接受的","x":-1140,"y":1725,"width":677,"height":55},
		{"id":"1f2ea567824fd524","type":"text","text":"动脑","x":-200,"y":-160,"width":82,"height":50},
		{"id":"5ccfb87e2f61feed","type":"text","text":"不动脑","x":-200,"y":40,"width":118,"height":50},
		{"id":"d9b446ac585dfe50","type":"text","text":"实事求是","x":-18,"y":40,"width":116,"height":50},
		{"id":"cb9940de190a4ba9","type":"text","text":"耍滑、不实诚，耍小聪明","x":161,"y":-160,"width":239,"height":50,"color":"1"},
		{"id":"9952ba3a12ce5fa2","type":"text","text":"真实","x":180,"y":40,"width":81,"height":50},
		{"id":"719c750ce70b793e","type":"file","file":"Pasted image 20260914105007.png","x":460,"y":-160,"width":847,"height":50},
		{"id":"ef8d32b22cdb75aa","type":"text","text":"动脑必然会得出结论，省略了很多东西，动脑就得取舍、做出判断，比如一条路100个台阶，正常人走一步一个，但是你经过大脑判断自己一步可以走十个台阶，那么这不就是省略步骤，这不就是不真诚吗","x":-159,"y":-733,"width":320,"height":213},
		{"id":"e0f6e48a48584e1d","type":"file","file":"Pasted image 20260914113356.png","x":-69,"y":-302,"width":400,"height":31},
		{"id":"df72a1629c5ffd1b","type":"text","text":"选择","x":150,"y":-424,"width":250,"height":60},
		{"id":"7b819494a487b989","type":"file","file":"Pasted image 20260914113452.png","x":221,"y":-701,"width":123,"height":50},
		{"id":"625fe1fd20398931","type":"text","text":"动脑","x":-380,"y":-80,"width":80,"height":60},
		{"id":"b02141d63d9e6ffb","type":"text","text":"分析取巧","x":-40,"y":-160,"width":120,"height":50},
		{"id":"8522286a998d8766","type":"file","file":"Pasted image 20260914105026.png","x":520,"y":40,"width":400,"height":57},
		{"id":"b965e068facbb170","type":"file","file":"Pasted image 20260914105039.png","x":920,"y":40,"width":498,"height":57},
		{"id":"5204909e4a1c0781","type":"text","text":"工具","x":-467,"y":-424,"width":250,"height":60},
		{"id":"642fdd51110fb2ca","type":"file","file":"Pasted image 20260914113359.png","x":-950,"y":-646,"width":650,"height":50},
		{"id":"f66788bc6dece5a3","type":"file","file":"Pasted image 20260914113518.png","x":529,"y":-733,"width":778,"height":112},
		{"id":"20dfdbd1418f44f9","type":"file","file":"Pasted image 20260914113729.png","x":-380,"y":-1040,"width":761,"height":50},
		{"id":"9cab838c73566fa7","type":"text","text":"改变是结果、而优化调整是过程","x":-1533,"y":1570,"width":273,"height":50},
		{"id":"b449a6d76ab67262","type":"file","file":"Pasted image 20260914105427.png","x":-399,"y":320,"width":878,"height":50},
