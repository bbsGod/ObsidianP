		{"id":"b224910a7e55ef60","type":"text","text":"底不下下头、拉不下脸","x":-1840,"y":2340,"width":228,"height":50},
		{"id":"2c661979534f6654","type":"text","text":"面子是可再生资源","x":-2097,"y":2340,"width":179,"height":50},
		{"id":"70f94c3484b732e6","type":"text","text":"扣上帽子","x":-1754,"y":2700,"width":122,"height":50},
