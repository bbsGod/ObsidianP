{
	"nodes":[
		{"id":"2389eb2e255d7ceb","type":"group","x":-8200,"y":1300,"width":13200,"height":15260,"label":"不接受改变"},
		{"id":"29d2ddd34f613247","type":"group","x":-7760,"y":5200,"width":12600,"height":11180,"label":"生而为人，我值得"},
		{"id":"30cff5e03bf8e7b5","type":"group","x":1315,"y":15640,"width":1770,"height":240,"label":"格物致知：探究事务获取正确的认知"},
		{"id":"4de3ef05aea71c7e","type":"group","x":-6040,"y":7080,"width":4715,"height":2040,"label":"「以恐惧为燃料、以内耗为闭环」的自我驱动系统—— 它让你的大脑永远处于 “开机扫描” 状态，永远在发力、永远在预判风险，于是紧张、反复思考、高度警惕就成了你的默认心理状态。"},
		{"id":"fa427dd1f1fee5dc","type":"group","x":-970,"y":-1060,"width":2408,"height":2010,"label":"圆滑世故"},
		{"id":"124856ab34c8acf4","type":"group","x":-7140,"y":9534,"width":2507,"height":1485,"label":"顶层信念"},
		{"id":"62d2f4a6c14ae7c2","type":"group","x":-200,"y":8740,"width":2927,"height":1140,"label":"有人做过"},
		{"id":"d0bf0754e405c7be","type":"group","x":-7580,"y":13000,"width":3556,"height":780,"label":"道德绑架和身份认同"},
		{"id":"5503a9755ccda85b","type":"group","x":16,"y":10100,"width":2304,"height":1180,"label":"自我审判"},
		{"id":"f42cdd6cf46ce8ae","type":"group","x":-830,"y":5860,"width":2509,"height":940,"label":"新秩序"},
		{"id":"c6d25126c3ae20ef","type":"group","x":-7580,"y":14020,"width":1984,"height":1140,"label":"老赵"},
		{"id":"9009758bb0792dfd","type":"group","x":-4400,"y":2474,"width":1520,"height":1166,"label":"我缺爱"},
		{"id":"bbdc20671a8a2463","type":"group","x":-2951,"y":3760,"width":1921,"height":900,"label":"自我恐吓"},
		{"id":"252d9a24ba8e5156","type":"group","x":200,"y":7740,"width":2790,"height":520,"label":"焦虑输出"},
		{"id":"70b2222899d0d6df","type":"group","x":-6563,"y":12086,"width":2301,"height":629,"label":"老辈子打法先带帽子"},
		{"id":"f1b41bbe46476bd8","type":"group","x":-2808,"y":5280,"width":2337,"height":480,"label":"放弃"},
		{"id":"8d6111544cb42d9e","type":"group","x":-3260,"y":5860,"width":1300,"height":740,"label":"封建糟粕荼毒"},
		{"id":"454f0a933eaadab8","type":"group","x":-4341,"y":1639,"width":859,"height":511,"label":"未命名组"},
		{"id":"625fe1fd20398931","type":"text","text":"动脑","x":-380,"y":-80,"width":80,"height":60},
		{"id":"d9b446ac585dfe50","type":"text","text":"实事求是","x":-18,"y":40,"width":116,"height":50},
		{"id":"b965e068facbb170","type":"file","file":"Pasted image 20260914105039.png","x":920,"y":40,"width":498,"height":57},
		{"id":"8522286a998d8766","type":"file","file":"Pasted image 20260914105026.png","x":520,"y":40,"width":400,"height":57},
		{"id":"5ccfb87e2f61feed","type":"text","text":"不动脑","x":-200,"y":40,"width":118,"height":50},
		{"id":"9952ba3a12ce5fa2","type":"text","text":"真实","x":180,"y":40,"width":81,"height":50},
		{"id":"cb9940de190a4ba9","type":"text","text":"耍滑、不实诚，耍小聪明","x":161,"y":-160,"width":239,"height":50,"color":"1"},
		{"id":"b02141d63d9e6ffb","type":"text","text":"分析取巧","x":-40,"y":-160,"width":120,"height":50},
		{"id":"df72a1629c5ffd1b","type":"text","text":"选择","x":150,"y":-424,"width":250,"height":60},
		{"id":"719c750ce70b793e","type":"file","file":"Pasted image 20260914105007.png","x":460,"y":-160,"width":847,"height":50},
		{"id":"5204909e4a1c0781","type":"text","text":"工具","x":-467,"y":-424,"width":250,"height":60},
		{"id":"7b819494a487b989","type":"file","file":"Pasted image 20260914113452.png","x":221,"y":-701,"width":123,"height":50},
		{"id":"f66788bc6dece5a3","type":"file","file":"Pasted image 20260914113518.png","x":529,"y":-733,"width":778,"height":112},
		{"id":"ef8d32b22cdb75aa","type":"text","text":"动脑必然会得出结论，省略了很多东西，动脑就得取舍、做出判断，比如一条路100个台阶，正常人走一步一个，但是你经过大脑判断自己一步可以走十个台阶，那么这不就是省略步骤，这不就是不真诚吗","x":-159,"y":-733,"width":320,"height":213},
		{"id":"642fdd51110fb2ca","type":"file","file":"Pasted image 20260914113359.png","x":-950,"y":-646,"width":650,"height":50},
		{"id":"20dfdbd1418f44f9","type":"file","file":"Pasted image 20260914113729.png","x":-380,"y":-1040,"width":761,"height":50},
		{"id":"1f2ea567824fd524","type":"text","text":"动脑","x":-200,"y":-160,"width":82,"height":50},
		{"id":"e0f6e48a48584e1d","type":"file","file":"Pasted image 20260914113356.png","x":-69,"y":-302,"width":400,"height":31},
		{"id":"faa7d01e681f9d19","type":"text","text":"想到了要抗压","x":-6337,"y":10003,"width":250,"height":50},
		{"id":"e30f12f55905877c","type":"text","text":"想到了内心更加关注负面情绪，疼痛，即使99，我也会为了那1分伤心难过一整天","x":-6914,"y":10000,"width":441,"height":52},
		{"id":"0f9b9bfaab298011","type":"text","text":"这些我认同的想法","x":-6949,"y":10160,"width":250,"height":60},
		{"id":"25bf75a3a3f478a4","type":"text","text":"想法反正都是行动的草稿，放了就忘了吧","x":-6497,"y":9880,"width":342,"height":50},
		{"id":"450dac67aea893a1","type":"text","text":"想到了，我这些想法忘了怎么办","x":-6914,"y":9880,"width":279,"height":50},
		{"id":"1b5cfc36403d9586","type":"text","text":"卧底，伟大的委屈，歌颂苦难","x":-1416,"y":14095,"width":250,"height":60},
		{"id":"ac4b94aab99d358c","type":"text","text":"没有好的学校，所以赚不到钱\n","x":-4979,"y":9869,"width":260,"height":50},
		{"id":"2ecd1e09f7f4f97a","type":"text","text":"想到我不能把期望放到别人身上","x":-6105,"y":9557,"width":305,"height":50},
		{"id":"67ab50ed7997ad85","type":"text","text":"想到了自己被迷惑了，钻进去了","x":-6052,"y":9718,"width":250,"height":60},
		{"id":"8993ec0dfeded0ae","type":"text","text":"潜意识的信念（规则）","x":-6405,"y":10907,"width":250,"height":60},
		{"id":"4713e900a437eb71","type":"text","text":"基于自己的判断行动","x":-5705,"y":11640,"width":250,"height":60},
		{"id":"e37be0d00cfb8a10","type":"text","text":"允许有疲惫、抵触，想法可以保留","x":-5705,"y":11515,"width":250,"height":60},
		{"id":"3a3fecbd8767c583","type":"text","text":"目标：达成自己认可的事","x":-5680,"y":11760,"width":250,"height":60},
		{"id":"bb82eda0df9a7a8c","type":"text","text":"觉得自己真实的想法，太弱智，上不了台面","x":-1415,"y":13953,"width":250,"height":60},
		{"id":"1e657a8478895329","type":"text","text":"自我限制无法表达的压抑","x":-1416,"y":14236,"width":250,"height":60},
		{"id":"8142e18e95e065f6","type":"text","text":"任何时候都要表现出积极乐观","x":-1433,"y":13778,"width":292,"height":50},
		{"id":"5b8b65483e8ee2e2","type":"text","text":"紧张","x":-542,"y":13400,"width":250,"height":60},
		{"id":"5cc1ac0bed1879d9","type":"text","text":"被人设牵着鼻子","x":-1412,"y":13609,"width":250,"height":60},
		{"id":"ea889e830a5fccd7","type":"text","text":"找工作","x":-1160,"y":12353,"width":118,"height":60},
		{"id":"f5e87008f8eed592","type":"text","text":"想到了接纳","x":-5921,"y":10005,"width":250,"height":50},
		{"id":"c777a9e9b1b5e6ab","type":"text","text":"标签认同","x":-5287,"y":10469,"width":124,"height":50},
		{"id":"5aa6da340064483b","type":"text","text":"儒雅 就是 软弱，没有血性","x":-4991,"y":10604,"width":250,"height":60},
		{"id":"b16a69593e6083e7","type":"text","text":"高智商的人就得失眠","x":-5013,"y":10469,"width":250,"height":60},
		{"id":"e875f4cd3e63ec99","type":"text","text":"有个性就是和别人不一样，就该生气，就该斤斤计较\n","x":-4993,"y":10743,"width":250,"height":60},
		{"id":"153a3a4f5bfaddcc","type":"text","text":"基于现实的因果论","x":-5310,"y":10090,"width":186,"height":57},
		{"id":"11e87c8abf535990","type":"text","text":"身份认同感","x":-5600,"y":10122,"width":136,"height":50},
		{"id":"82ec2095d8de42d7","type":"text","text":"上学学习是唯一，工作i赚钱是唯一","x":-5008,"y":10305,"width":304,"height":50},
		{"id":"e21d885941dd18c5","type":"text","text":"高矮胖瘦，优秀的定义","x":-5036,"y":10206,"width":250,"height":60},
		{"id":"014a4692bfa26691","type":"text","text":"当老大就该懂事","x":-4979,"y":10030,"width":250,"height":60},
		{"id":"5b057f50880a7c47","type":"text","text":"而你现在有了两个孩子，会格外怕老大受委屈，本质上就是你心里那个当年站在不公平里、没人撑腰的小孩，终于借着当爸爸的身份，站出来说一句 “这不公平”。 你不想让你的大女儿再经历一遍：要靠懂事换关注、要靠优秀换尊严、明明是老大却要处处让着的委屈。你在给她公平，其实也是在给当年的自己补一份公平。\n\n而当你把这些都摊开看清楚 —— 那些 “必须懂事、必须优秀、必须比别人强”，从来都不是什么天经地义的真理，只是一套不公平的、用来约束你的规则。 你脑子里那个无时无刻不在的自我审判官，它的底气其实就来自当年这套规则。现在你看穿了它的来路，它就再也不能理所当然地审判你了。","x":510,"y":10640,"width":192,"height":50},
		{"id":"df1b74a85d3c010f","type":"text","text":"老大规则","x":547,"y":10466,"width":117,"height":54},
		{"id":"c14f0b1a79e7fc35","type":"text","text":"“都是为你好”。","x":831,"y":10378,"width":193,"height":50},
		{"id":"8384d5481422101c","type":"text","text":"基于别人的评价","x":-5310,"y":10209,"width":170,"height":50},
		{"id":"37387bdef63b038d","type":"text","text":"身体不适有点头疼","x":-6917,"y":9712,"width":195,"height":50},
		{"id":"879f0533c5f53be6","type":"text","text":"想到了自己以前高中的时候流行的一本数据 叫秘密 英语单词的 ，里边就将想法可以控制宇宙啥的","x":-6574,"y":9684,"width":345,"height":123},
		{"id":"08f91ce7160702d6","type":"text","text":"想到自己追求的标准是为了再别人面前的表现","x":-6477,"y":9554,"width":250,"height":60},
		{"id":"1fac4821dc96781b","type":"text","text":"失眠了","x":-7120,"y":9718,"width":104,"height":50},
		{"id":"2aff2a83517d98e4","type":"text","text":"想到了自己睡觉的方式都要循规蹈矩的 要学别人一样的方式","x":-6949,"y":9560,"width":349,"height":50},
		{"id":"08aa3dfa8db6b835","type":"text","text":"规矩全是给你定的，宽容全是给他留的","x":996,"y":10880,"width":250,"height":60},
		{"id":"feb60aef83a643c3","type":"text","text":"你格外疼老大、怕她受冷落，本质上就是你在心里悄悄给当年的自己平反","x":450,"y":11057,"width":350,"height":50},
		{"id":"624b6269b26f6885","type":"text","text":"只给责任，为啥不给权力","x":993,"y":10640,"width":250,"height":60},
		{"id":"28e8c0e9dd3115e7","type":"text","text":"双标的、不公平的","x":796,"y":10470,"width":161,"height":50},
		{"id":"ceb6ca840e3772d6","type":"text","text":"责任全在你，好处全在他","x":996,"y":10753,"width":250,"height":60},
		{"id":"7d551396db709b98","type":"text","text":"不用只扛着所有东西往前走，连停下来委屈一下都觉得是自己不懂事","x":1017,"y":11184,"width":346,"height":73},
		{"id":"cf721800b1f8830a","type":"text","text":"没有权力匹配的责任","x":499,"y":10960,"width":203,"height":50},
		{"id":"279fd9f547362ef1","type":"text","text":"**方面的道德绑架和义务强加**。","x":749,"y":10960,"width":268,"height":56},
		{"id":"f756486a7520d397","type":"text","text":"不公平啊","x":539,"y":10723,"width":250,"height":60},
		{"id":"edd610a6cbee3e5f","type":"text","text":"想想自己有什么权力，就有什么责任","x":120,"y":11190,"width":250,"height":60},
		{"id":"21a6d47f8d225326","type":"text","text":"我觉得承认自己那件事不行，时间很耻辱的事情，不行的这件事比天还大","x":2000,"y":13750,"width":299,"height":96},
		{"id":"571075792bf573a4","type":"text","text":"我不需要，你高高在上的评价","x":1208,"y":12402,"width":250,"height":60},
		{"id":"8b8aabb69cabee56","type":"text","text":"窒息逃避","x":1640,"y":11940,"width":250,"height":60},
		{"id":"6f37247f89fc3f51","type":"text","text":"别人的评价","x":1289,"y":12158,"width":250,"height":60},
		{"id":"3d511659760a8b5f","type":"text","text":"你开始知道，有多少身份，就该有多少偏爱；","x":1043,"y":11032,"width":400,"height":50},
		{"id":"3207cc9f76c55a79","type":"text","text":"只许自己尽义务，不许自己讲权利","x":1402,"y":10638,"width":358,"height":50},
		{"id":"28f2b4154f0ed1f9","type":"text","text":"只许自己审判自己，不许自己放过自己。","x":1383,"y":10698,"width":337,"height":55},
		{"id":"9b87f3caaa64e84e","type":"text","text":"所有好处都是老二的，所有枷锁都是我的。","x":1121,"y":10560,"width":319,"height":50},
		{"id":"e6a0210492f11601","type":"text","text":"它只给你扣头衔、压责任，却不给你对应的尊严、话语权和偏爱","x":1123,"y":10463,"width":317,"height":57},
		{"id":"be035da2200afde9","type":"text","text":"有多少责任，就该有多少尊严","x":1042,"y":11093,"width":321,"height":50},
		{"id":"bb61e0b329c8a083","type":"text","text":"尊严抗拒的贬低","x":55,"y":13988,"width":250,"height":60},
		{"id":"7f1f56ac1417eb0d","type":"text","text":"困难是暂时的、结果也是暂时的","x":399,"y":13785,"width":281,"height":50},
		{"id":"04a829300eed04b7","type":"text","text":"把一刻当永久","x":440,"y":13584,"width":160,"height":50},
		{"id":"eafa2ac51e6d55c0","type":"text","text":"把自己处于低等的人","x":767,"y":13802,"width":250,"height":60},
		{"id":"7e640a69589e4d8f","type":"text","text":"哪些不如自己的人是不是也在努力的活着","x":767,"y":13967,"width":250,"height":60},
		{"id":"b6896a0f73a40680","type":"text","text":"期许，事情不如意，就会有压力","x":1155,"y":13772,"width":250,"height":60},
		{"id":"25d0fe24202b3372","type":"text","text":"别人呢行你为什么不行","x":1840,"y":13553,"width":250,"height":60},
		{"id":"9ca87dd74f95375d","type":"text","text":"不听老人言吃亏在眼前","x":1840,"y":13361,"width":250,"height":60},
		{"id":"27958830d1edb81d","type":"text","text":"担心会被审判","x":52,"y":13593,"width":250,"height":60},
		{"id":"642f66360fd06d40","type":"text","text":"我不是圣人，为啥非得行","x":2025,"y":13968,"width":250,"height":60},
		{"id":"7ac64499f9fcff6c","type":"text","text":"内心人分三六九等","x":768,"y":13606,"width":250,"height":60},
		{"id":"f1cec0024bfd1502","type":"text","text":"人只要活着就得要面对压力","x":1156,"y":13613,"width":250,"height":60},
		{"id":"95f7e690a18a4b71","type":"text","text":"不动脑子，完全按照别人的计划来，最快了","x":-7077,"y":11545,"width":250,"height":60},
		{"id":"987a8e982f257cdb","type":"text","text":"从来都不全是为了你，里面掺着父母的脸面、焦虑，和他们自己都未必察觉的虚荣心。","x":904,"y":10146,"width":377,"height":68},
		{"id":"3c34bad9445aab86","type":"text","text":"你是老大你就该懂事","x":796,"y":10298,"width":228,"height":52},
		{"id":"c1edb72e6342b4f4","type":"text","text":"道德绑架","x":529,"y":10300,"width":135,"height":50},
		{"id":"12b76db73686b1c9","type":"text","text":"自我有了两个孩子，才发现老大如果不被留意，真的很容易受到冷落和委屈，我当时和自己的弟弟差一岁，家里即要让我董事，又要让我学习好，而且一点权力也不给我，说的是我和弟弟谁说的对听谁的，后边告诉我，想让人家觉得老大董事，那你告诉我嘛 你这样不公平的要求到底是为了我，还是为了你自己嘛，孩子就是给你增加脸面的吗，你怕人家看不起，那孩子冲排名，所有你这样的要求，我可以完全理解为都是为了你自己，既然老大的身份是注定的，那么为啥老大的一点尊严都没有，被要求着，有时候还要自己去维护我作为老大的尊严，你让我做老大，确实一点也不维护老大的尊严，因为你是老大所以一定要懂事，你告诉我是老大，却因为你说谁说的对听谁的，丢了话语权，总不能亏都让老大吃了，便宜都被老二沾了，而且是沾了便宜还卖乖的那种，我要达到你的要求，在你那老大的责任，老二却没有的责任； 还要自己去维护老大的尊严，老二脑子好用学习比我好，我们在一个年级，我就得样样比老二好才是应该的，老二比我好那是他越秀，我比他好是应该的，这对吗，这公平吗","x":36,"y":10120,"width":228,"height":116},
		{"id":"571d14a575cae162","type":"text","text":"“必须懂事、必须成绩好” 的要求","x":464,"y":10150,"width":250,"height":60},
		{"id":"8170ff269c7393b4","type":"text","text":"只要结果","x":-7440,"y":11545,"width":250,"height":60},
		{"id":"a8c93ec66dd1b219","type":"text","text":"自我卑微的认同","x":-5310,"y":10949,"width":187,"height":50},
		{"id":"2c5ea016fd9ba6f5","type":"text","text":"假装理解了，说出自己不懂得地方让人家绝的自己很蠢","x":-7099,"y":11821,"width":339,"height":60},
		{"id":"45ca0fa219ba1237","type":"text","text":"亢奋","x":-7099,"y":11960,"width":250,"height":60},
		{"id":"5d33d88ba2eefb72","type":"text","text":"服从","x":-7082,"y":11686,"width":250,"height":60},
		{"id":"35e06019ff203cc4","type":"text","text":"认为别人的身份就别自己高","x":-4911,"y":10939,"width":250,"height":60},
		{"id":"b76e0231bf6b5dee","type":"text","text":"服从他人计划，抛弃逻辑","x":-5216,"y":11636,"width":250,"height":60},
		{"id":"3d8565ed4a520374","type":"text","text":"目标：获得他人认可","x":-5213,"y":11753,"width":250,"height":60},
		{"id":"266efff68f94d87c","type":"text","text":"核心：优先别人，牺牲自我感受","x":-5241,"y":11260,"width":250,"height":60},
		{"id":"6a9bcb18689ebb58","type":"text","text":"不能有负面情绪，不能有自己想法","x":-5230,"y":11513,"width":250,"height":60},
		{"id":"d45928e47f2f9f63","type":"text","text":"自己给自己一个领袖的身份，完美的人设","x":-7551,"y":11821,"width":361,"height":56},
		{"id":"18579a4a6513296f","type":"text","text":"我需要这个吗？","x":-6000,"y":10912,"width":250,"height":60},
		{"id":"987453ad012fb0de","type":"text","text":"核心：我主动选择，兼顾双方，守住边界","x":-5705,"y":11260,"width":250,"height":60},
		{"id":"448a416d1c3ebb87","type":"text","text":"所谓的积极状态、快","x":-6186,"y":11485,"width":250,"height":60},
		{"id":"09f60c6c6b2ee184","type":"text","text":"隐藏信念（很容易被你内化）：**他不断挑我的错，是我真的不行；我要接住这份 “恨铁不成钢”，努力变好，才能获得认可**","x":-6089,"y":12413,"width":286,"height":127},
		{"id":"5c124efdf615a0ba","type":"text","text":"可以评估，能拒绝，可延迟，有选择空间","x":-5705,"y":11402,"width":250,"height":60},
		{"id":"97b87e5e193e2fc9","type":"text","text":"所以当你不舒服了，不自在了，难受了，憋屈了，问问自己内心在认同什么","x":-7120,"y":10917,"width":575,"height":50},
		{"id":"0993d542798339f2","type":"text","text":"立刻马上完成别人的期望","x":-7077,"y":11145,"width":250,"height":60},
		{"id":"b726f5b23f33e3e4","type":"text","text":"表达的自己的想法就是浪费时间","x":-7077,"y":11290,"width":250,"height":60},
		{"id":"7f70a5c9fc081e3a","type":"text","text":"思考也是浪费时间","x":-7077,"y":11391,"width":250,"height":60},
		{"id":"96a1e74fb53b8ca3","type":"text","text":"必须快速、立刻满足期待","x":-5239,"y":11397,"width":250,"height":60},
		{"id":"6e228afbd7e1f8ff","type":"text","text":"贫农","x":-6322,"y":14340,"width":101,"height":50},
		{"id":"9eec366579ff6378","type":"text","text":"如果孝顺的代价是失去自我无尽的贬低自己，不孝顺就不孝顺吧，践踏尊严","x":-6138,"y":14189,"width":302,"height":54},
		{"id":"8fc05cc5b6060b95","type":"text","text":"无礼不孝","x":-6333,"y":14193,"width":123,"height":50},
		{"id":"718e740176671e40","type":"text","text":"没钱不丢人，不偷不抢，干干净净，安心","x":-6035,"y":14340,"width":250,"height":60},
		{"id":"871eb17044aee9e4","type":"text","text":"扣帽子道德绑架","x":-6834,"y":14243,"width":250,"height":60},
		{"id":"8fa1a03cf668ec4d","type":"text","text":"我是不是认同：**只要长辈用 “为我好” 当理由，我就必须接纳他对我的贬低，承认我本身很差**","x":-4680,"y":12301,"width":398,"height":50},
		{"id":"40261a47bf722ebf","type":"text","text":"我被绑架，或则和被人绑架：试图绑定一个预设的框架将我框在这个框架中","x":-5087,"y":12430,"width":468,"height":57},
		{"id":"9376c439e2e6c965","type":"text","text":"辩解是大坑：你一旦开始解释自己不傻、不菜，就等于进入他的游戏规则，拼命证明自己，持续内耗","x":-5119,"y":12123,"width":500,"height":50},
		{"id":"cb6ef6d4abaa43b7","type":"text","text":"我接受，不挣扎这个帽子对不对","x":-6837,"y":14451,"width":250,"height":60},
		{"id":"9d5d9e9f82d3a2c2","type":"text","text":"别人","x":-6652,"y":13270,"width":100,"height":50,"color":"4"},
		{"id":"165e1a6d02897a3e","type":"text","text":"不再觉得是别人在要求我，我以为这就是 “我本来就该有的样子”，这就是事实","x":-6938,"y":13453,"width":634,"height":50,"color":"4"},
		{"id":"355344e2f312d872","type":"text","text":"自己","x":-5646,"y":13446,"width":100,"height":50},
		{"id":"682fb8cf604b7b1d","type":"text","text":"自己绑自己","x":-6160,"y":13453,"width":250,"height":50},
		{"id":"304d03c8ddf9fd94","type":"text","text":"不需要这个身份认同，更不需要别人的道德绑架","x":-6023,"y":13648,"width":427,"height":50,"color":"1"},
		{"id":"a4ac51858220016b","type":"text","text":"闹我难堪，弄我丢人不是？","x":-6386,"y":14040,"width":250,"height":60},
		{"id":"212590ac629ec587","type":"text","text":"在你那我就该不孝，你都不尊重我，我孝顺你干啥？","x":-6473,"y":14457,"width":250,"height":60},
		{"id":"91fcdf9b49de8758","type":"text","text":"就给你要钱，你以后用我必须给钱，我就给你要","x":-6468,"y":14559,"width":250,"height":60},
		{"id":"cbabb2308fe00969","type":"text","text":"我的价值，底线是我自己定义的，别人的怎么评价，是别人的事情，我干嘛要买单","x":-6852,"y":14720,"width":268,"height":120},
		{"id":"66d1f3a235e1b7d2","type":"text","text":"老赵","x":-7486,"y":14920,"width":102,"height":50},
		{"id":"aa2c961f09d04f10","type":"text","text":"是谁在施压，是谁在提出要求","x":-6383,"y":13260,"width":285,"height":69},
		{"id":"0b8da25c9bc9c6d5","type":"text","text":"定义标准，用情理、身份、道德当理由，强迫服从","x":-5968,"y":13260,"width":422,"height":50},
		{"id":"ebc81cefc5068e85","type":"text","text":"老辈子打法就是上线先扣帽子","x":-6084,"y":12635,"width":250,"height":60},
		{"id":"8a5688eb458b4b66","type":"text","text":"我嫌你傻菜","x":-5561,"y":12333,"width":250,"height":60},
		{"id":"88cbb67df7964324","type":"text","text":"他的借口：**我的贬低 = 为你好，动机是爱 / 期待**","x":-6053,"y":12240,"width":250,"height":60},
		{"id":"515142bd42bb6d89","type":"text","text":"我不需要这个身份认同","x":-5088,"y":12296,"width":250,"height":60},
		{"id":"eac530498dd4f6fc","type":"text","text":"把人塞进固定角色里，规定你 “应该是什么样、应该怎么想、应该怎么做”，一旦偏离框架，就产生负罪感、自我否定。","x":-4935,"y":13260,"width":891,"height":50},
		{"id":"2080640d57e75e4e","type":"text","text":"框架绝对化、剥夺选择权，否定你的感受与主体","x":-5446,"y":13060,"width":383,"height":50},
		{"id":"9073d351ca9bf474","type":"text","text":"认同这个预设，开始自我攻击","x":-7560,"y":13436,"width":250,"height":60,"color":"4"},
		{"id":"da044ff072327bb6","type":"text","text":"高标准","x":-468,"y":13620,"width":250,"height":50},
		{"id":"fdf1392c43982d11","type":"text","text":"服务别人","x":-7099,"y":12266,"width":250,"height":60},
		{"id":"e434566d242daef2","type":"text","text":"期待一个人变好 ≠ 持续贬低、否定、贴标签（傻、菜）。","x":-6460,"y":12106,"width":275,"height":84},
		{"id":"02e9fa4377c99644","type":"text","text":"把**他的情绪和不耐烦**，包装成对你的善意。","x":-6543,"y":12457,"width":250,"height":60},
		{"id":"85d45afda25c3520","type":"text","text":"真正希望人变好，是指出具体事情，而不是攻击人的本身。","x":-6460,"y":12258,"width":260,"height":68},
		{"id":"0cae2e684295143c","type":"text","text":"预设框架","x":-5319,"y":13260,"width":129,"height":50},
		{"id":"f3815113f8ef3c8d","type":"text","text":"抛弃逻辑，全程参与到别人的设计中","x":-7197,"y":12059,"width":348,"height":61},
		{"id":"68ed96241f8f4f95","type":"text","text":"抛弃的自己，抛弃自己的想法，自己的情绪，以别人为主","x":-7313,"y":12165,"width":464,"height":50},
		{"id":"faf22055f8926503","type":"file","file":"Pasted image 20261015095109.png","x":-7340,"y":12436,"width":672,"height":208},
		{"id":"68b7b2a3b9747bb9","type":"text","text":"脱离现实的期望","x":-467,"y":13809,"width":250,"height":60},
		{"id":"c177ab075a03107f","type":"text","text":"所做的选择都是为了讨好审判员","x":37,"y":14154,"width":286,"height":58},
		{"id":"c5a2f91ad8a7018a","type":"text","text":"放大缺点","x":52,"y":13768,"width":250,"height":60},
		{"id":"4dcc47fe697446d9","type":"text","text":"我不想听你的建议，我也不接受你的批评","x":1820,"y":14080,"width":250,"height":60},
		{"id":"9d3637bc42588af2","type":"text","text":"用自己的话说，不要用他的话来说他","x":2131,"y":14069,"width":250,"height":60},
		{"id":"52de4b1cc67cd7d5","type":"text","text":"任何人不一样","x":2461,"y":13767,"width":250,"height":60},
		{"id":"d1668ed24e4a2979","type":"text","text":"听话","x":1820,"y":14240,"width":250,"height":52},
		{"id":"06bf0782808b331c","type":"text","text":"不要控制我","x":2220,"y":14238,"width":250,"height":60},
		{"id":"f7a4ec2d4b8b7518","type":"text","text":"你能不能懂不重要，我能懂就行","x":2505,"y":14069,"width":250,"height":60,"color":"1"},
		{"id":"ac7ea2f7b322a7f9","type":"text","text":"担心、害怕结果的发生","x":-880,"y":13620,"width":250,"height":60},
		{"id":"f15426665a10d01f","type":"text","text":"虚荣心作祟","x":-473,"y":14338,"width":250,"height":60},
		{"id":"9d2a6ee470e91357","type":"text","text":"不接受结果的执念，强制改变自己对结果的认知","x":-882,"y":14208,"width":250,"height":60},
		{"id":"50e7a77674f39cde","type":"text","text":"落差感带来的耻辱感","x":-471,"y":14005,"width":250,"height":60},
		{"id":"19eeefc96fb14a40","type":"text","text":"被人嘲笑的努力","x":-474,"y":14182,"width":250,"height":60},
		{"id":"0b102e74afe5aa3c","type":"text","text":"想逃避的危险","x":-880,"y":14018,"width":250,"height":60},
		{"id":"9f0632c28f242c68","type":"text","text":"不识好歹","x":1820,"y":14400,"width":250,"height":60},
		{"id":"9a21933d68950435","type":"text","text":"你还道貌岸然呢","x":2245,"y":14400,"width":250,"height":60},
		{"id":"b39b0a5dc9c2ac1f","type":"text","text":"合适的压力才会带来合适的动力","x":1138,"y":13940,"width":250,"height":60},
		{"id":"78854f30c7cf63ef","type":"text","text":"物品","x":-1393,"y":2130,"width":104,"height":50},
		{"id":"4678372c0a5f0e55","type":"text","text":"物质","x":-1393,"y":2315,"width":92,"height":50},
		{"id":"b83bdc94305ec137","type":"text","text":"冰冷、没有感情","x":-1101,"y":2130,"width":171,"height":50},
		{"id":"d11c0dc86492fe7c","type":"text","text":"事情","x":-1393,"y":2205,"width":104,"height":50},
		{"id":"a89ad7c28af8d9bf","type":"text","text":"看不起","x":2931,"y":11932,"width":250,"height":60},
		{"id":"1fc21dfcb05f7b48","type":"text","text":"他开始耍无赖了，说嘿嘿 我和他不一样，我哪有他那个条件啊 巴拉巴拉。。。","x":2970,"y":13588,"width":364,"height":71},
		{"id":"5f3ff83ca93123aa","type":"text","text":"自我放弃","x":-2011,"y":5598,"width":250,"height":60},
		{"id":"cb48583d692a8f32","type":"text","text":"察觉","x":-1607,"y":5691,"width":115,"height":50,"color":"1"},
		{"id":"64cd319a63c7bbe6","type":"text","text":"不是改变、而是优化，调整","x":-1449,"y":1766,"width":249,"height":54},
		{"id":"41e7e6abc7d5f442","type":"text","text":"一个猴一个栓法","x":-1540,"y":2033,"width":160,"height":50},
		{"id":"6c5a08c114c6e2f4","type":"text","text":"改掉的叫缺点、改不掉的叫弱点","x":-1540,"y":1870,"width":300,"height":63},
		{"id":"6f2bbfe24a981672","type":"text","text":"这个过程才是需要是可面、经历的","x":-1561,"y":1422,"width":321,"height":50},
		{"id":"9cab838c73566fa7","type":"text","text":"改变是结果、而优化调整是过程","x":-1473,"y":1610,"width":273,"height":50},
		{"id":"c240eb30a52d48f0","type":"text","text":"讨论个问题，改变 和 优化调整 那个更适合现在的自己，我接受不了改变，我认为改变这个词是贬义词，是对自己的否定，我会陷入自卑恐惧中，而优化调整是我能接受的","x":-1080,"y":1765,"width":677,"height":55},
		{"id":"2c661979534f6654","type":"text","text":"面子是可再生资源","x":-2097,"y":2340,"width":179,"height":50},
		{"id":"b224910a7e55ef60","type":"text","text":"底不下下头、拉不下脸","x":-1840,"y":2340,"width":228,"height":50},
		{"id":"6ebf99a97bc3fb5f","type":"text","text":"难为情、不好意思","x":-2040,"y":2180,"width":183,"height":50},
		{"id":"08a815a9c77ff895","type":"text","text":"世人皆醉 我独醒","x":-1886,"y":5870,"width":250,"height":60},
		{"id":"952bb9f5f07171ee","type":"text","text":"做决定","x":-1760,"y":2860,"width":133,"height":66},
		{"id":"70f94c3484b732e6","type":"text","text":"扣上帽子","x":-1754,"y":2700,"width":122,"height":50},
		{"id":"8362552e47b47398","type":"text","text":"戴着枷锁的舞者","x":-1850,"y":6066,"width":179,"height":60},
		{"id":"a447a9a5c3c378fd","type":"text","text":"「对外输出」","x":-1999,"y":8581,"width":250,"height":60},
		{"id":"5707f6b7d9cb05e1","type":"text","text":"「真实反馈」","x":-1632,"y":8581,"width":173,"height":50},
		{"id":"8d84208d4b4e8a2c","type":"text","text":"积极","x":-2745,"y":2775,"width":250,"height":60},
		{"id":"6693a91bb21ac789","type":"file","file":"Pasted image 20260914135527.png","x":-1790,"y":2620,"width":397,"height":56},
		{"id":"907afb017f5bb1e0","type":"text","text":"难为情","x":-1726,"y":2467,"width":167,"height":50},
		{"id":"381ee1d2a75cd7ec","type":"text","text":"不接受评价，不接受任人拿捏","x":-2004,"y":3066,"width":257,"height":60},
		{"id":"3c776d52ccd645eb","type":"text","text":"我怎么做，不用你来教我","x":-2273,"y":3066,"width":233,"height":60},
		{"id":"ee7b883c603f8d90","type":"text","text":"悲观","x":-2896,"y":3252,"width":250,"height":60},
		{"id":"6fa003bb869d5ecc","type":"text","text":"控制","x":-2569,"y":2873,"width":94,"height":53},
		{"id":"c5cf5e5c71f0085d","type":"text","text":"面对一点挫折，就当成终点","x":-2475,"y":3250,"width":236,"height":60},
		{"id":"1f96d3d0b647070c","type":"text","text":"不接受批评、不接受指责","x":-2540,"y":3060,"width":232,"height":66},
		{"id":"03969fabd013a432","type":"text","text":"只顾眼吧前的事情","x":-2431,"y":3420,"width":202,"height":50},
		{"id":"500026ec8143840a","type":"text","text":"不思进取","x":-2464,"y":2760,"width":118,"height":50},
		{"id":"62a43a13c3543037","type":"text","text":"我不解决别人的规则","x":-1684,"y":3066,"width":250,"height":60},
		{"id":"fa61bd0eb88b7567","type":"text","text":"不去考虑明天了","x":-2068,"y":3246,"width":189,"height":58},
		{"id":"a13866ab9980f6f9","type":"text","text":"没有长远的考虑","x":-2031,"y":3410,"width":250,"height":60},
		{"id":"0c58de74e010f2cb","type":"text","text":"是急从权","x":-2520,"y":2340,"width":123,"height":50},
		{"id":"4245f47701c1169e","type":"text","text":"高姿态","x":-1957,"y":2460,"width":136,"height":50},
		{"id":"e0887092aba79280","type":"text","text":"满足现状","x":-2475,"y":2623,"width":139,"height":50},
		{"id":"135a8c4df7684d85","type":"text","text":"肯定自己","x":-2680,"y":2485,"width":119,"height":50},
		{"id":"168fba0d8bdca527","type":"text","text":"抗压","x":-2669,"y":2648,"width":97,"height":50},
		{"id":"450307417513bed2","type":"text","text":"不","x":-2122,"y":2860,"width":115,"height":57},
		{"id":"9a999c34c24af92e","type":"text","text":"评价","x":-2239,"y":2626,"width":142,"height":50},
		{"id":"15a3b5aee8c96fd5","type":"text","text":"管不了那么多","x":-2300,"y":2180,"width":153,"height":50},
		{"id":"d8c0caafa2a32922","type":"text","text":"满足别人的规则","x":-2223,"y":1500,"width":183,"height":60},
		{"id":"da206316d54b5d2b","type":"text","text":"否定自己，破碎、重组","x":-1946,"y":1660,"width":250,"height":50},
		{"id":"21f46356574bb617","type":"text","text":"盲从、随波逐流","x":-2668,"y":1933,"width":168,"height":60},
		{"id":"954c78db4dd82ebf","type":"text","text":"规划","x":-2720,"y":2038,"width":80,"height":50},
		{"id":"609b9747627ee89a","type":"text","text":"改变自己","x":-2097,"y":1820,"width":125,"height":50},
		{"id":"c915a0da4c73577d","type":"text","text":"判断","x":-2365,"y":2033,"width":90,"height":50},
		{"id":"face12e0885c92dd","type":"text","text":"该驳的面子就得驳","x":-2366,"y":1820,"width":182,"height":50},
		{"id":"3ab597a109c7b2d1","type":"text","text":"下次再找回来","x":-2229,"y":2442,"width":161,"height":50},
		{"id":"d29bf17f13892e84","type":"text","text":"哪有什么面面俱到","x":-2321,"y":2340,"width":174,"height":50},
		{"id":"8e4c3a37d4890ae4","type":"text","text":"铺了路基","x":250,"y":9339,"width":110,"height":50},
		{"id":"155e4fabc31acff8","type":"text","text":"这条路是通的","x":464,"y":9339,"width":146,"height":50},
		{"id":"f8182ded79f3cf15","type":"text","text":"有人做过","x":-38,"y":9448,"width":138,"height":50},
		{"id":"c62d2543fc856509","type":"text","text":"以前我让自己大度一点，面对别人的道歉我都是一笑泯恩仇，但是后边我发现我身边一个朋友，别人给他道歉也没有用了，然后我也选择了斤斤计较，选择了不原谅，我在想是朋友影响到了吗，还是说我本来就是这样的人，只不过我朋友的方式更加吸引我，因为我弟弟的缘故，我刻意做了很多自以为是的差异性","x":1932,"y":8905,"width":250,"height":60},
		{"id":"19073db73c5a7f78","type":"text","text":"脑子转起来轻松，也不烦燥，很耐心","x":287,"y":9132,"width":250,"height":60},
		{"id":"616b48470ea45196","type":"text","text":"面对不同的人","x":-1840,"y":2033,"width":160,"height":50},
		{"id":"eb30d08bfb1314eb","type":"text","text":"保守、基础上优化","x":-1930,"y":1873,"width":234,"height":60},
		{"id":"d37d58514133d1a0","type":"text","text":"我","x":-2097,"y":2033,"width":57,"height":50},
		{"id":"079017eb5635b0d8","type":"text","text":"把自己变成别人期望","x":-2475,"y":1500,"width":200,"height":60},
		{"id":"2fb5745d24a24964","type":"text","text":"期许","x":-2335,"y":1660,"width":120,"height":50},
		{"id":"e52f9440c9c51cec","type":"text","text":"输入","x":680,"y":7945,"width":94,"height":50},
		{"id":"bb8afc29f6fe24a1","type":"text","text":"现实层面的不满足和心里层面的内在焦虑","x":220,"y":7945,"width":360,"height":50},
		{"id":"e54d9820520e07bf","type":"text","text":"坑已经被踩过了","x":679,"y":9339,"width":177,"height":50},
		{"id":"6b54bfef5bfe31aa","type":"text","text":"我可以少走很多弯路","x":944,"y":9339,"width":224,"height":50},
		{"id":"87692bb7349bb8fd","type":"text","text":"有人做过","x":-30,"y":9680,"width":138,"height":50},
		{"id":"365c8bbd70141995","type":"text","text":"做一个自己的版本","x":727,"y":9678,"width":217,"height":50},
		{"id":"7ae312f1f04cf427","type":"text","text":"做一个属于我的、能用的版本","x":273,"y":9511,"width":264,"height":50},
		{"id":"47b47a55cd31acad","type":"text","text":"我会表现的很烦躁，脑袋很重，就像被什么东西填满了一样","x":767,"y":8872,"width":353,"height":63},
		{"id":"4a11f3d376aad2ea","type":"text","text":"有没有人做过","x":275,"y":8875,"width":250,"height":60},
		{"id":"4c5afbdccbb26725","type":"text","text":"看不上java的工作，又得指望着它赚钱","x":2934,"y":12168,"width":250,"height":60},
		{"id":"bfc33c98fa7d062d","type":"text","text":"这个看不上是别人的视角","x":3399,"y":12093,"width":250,"height":60},
		{"id":"02f7f02f80d3b052","type":"text","text":"指望它赚钱是自己的现实","x":3380,"y":12235,"width":250,"height":60},
		{"id":"12957e65b98380a6","type":"text","text":"是我看不上，还是说别人看不上","x":2940,"y":12385,"width":250,"height":60},
		{"id":"1fd2250a281c34c6","type":"text","text":"按照自己的节奏","x":829,"y":6121,"width":161,"height":50},
		{"id":"dfaba99f762b3170","type":"text","text":"不会因为虚度年华而悔恨、不会因为碌碌无为而羞愧","x":1208,"y":6291,"width":250,"height":60},
		{"id":"4113f320132a9dc5","type":"text","text":"容易知足","x":910,"y":6299,"width":138,"height":50},
		{"id":"c2e9463c30fa8204","type":"text","text":"面对现实、接受自己缺点","x":579,"y":6299,"width":250,"height":60},
		{"id":"1ef35c5f740aa56d","type":"text","text":"做一件事情","x":-30,"y":8880,"width":130,"height":50},
		{"id":"6d70e7ab4eb889f0","type":"text","text":"路是通的可以作为参考","x":334,"y":9681,"width":226,"height":50},
		{"id":"b1d3e3703d7f0288","type":"text","text":"礼貌、文明","x":-658,"y":6166,"width":165,"height":50,"color":"1"},
		{"id":"3f4dc547185c36cf","type":"text","text":"文明社会，并非就一张试卷，怎么会有统一标准呢","x":49,"y":6502,"width":250,"height":60},
		{"id":"3b3cacf1e6bc7ffd","type":"text","text":"而不是去遮掩，去逃避","x":586,"y":6452,"width":213,"height":50},
		{"id":"abcf46e24d8b5db4","type":"text","text":"想法只是==行动的草稿==、用完就扔的==工具==","x":1262,"y":7942,"width":250,"height":60},
		{"id":"3411c0abc94a3549","type":"text","text":"改变","x":984,"y":7942,"width":100,"height":50},
		{"id":"2d175b540241d856","type":"text","text":"先动起来而不是先变完美","x":1657,"y":7942,"width":250,"height":60},
		{"id":"3ad9c6284c02b130","type":"text","text":"「真实反馈」","x":2797,"y":7945,"width":173,"height":50},
		{"id":"4f1904f133f81557","type":"text","text":"行动","x":2057,"y":7947,"width":99,"height":50},
		{"id":"9797e3c3608bc4d4","type":"text","text":"「对外输出」","x":2297,"y":7940,"width":250,"height":60},
		{"id":"9f4964668ff9d6f1","type":"text","text":"不依附","x":-99,"y":6360,"width":132,"height":60},
		{"id":"ed343731f1ec2fb9","type":"text","text":"边界","x":-203,"y":6146,"width":104,"height":50},
		{"id":"bf446967bc4db6c6","type":"text","text":"别人的局限性，认知和我无关，我不负责","x":-401,"y":6360,"width":250,"height":60},
		{"id":"c5f781a3e18ca9eb","type":"text","text":"等级，排序","x":102,"y":6304,"width":143,"height":50},
		{"id":"40e70944a84e5655","type":"text","text":"己所不欲勿施于人","x":3485,"y":13593,"width":250,"height":60},
		{"id":"d84be6c18963aaf5","type":"text","text":"给你的 “万能想法” 设一个**48 小时落地保质期**：一个想法如果在两天内，拆不出一件今天就能做、只花 30 分钟的具体小事，就直接判定为 “空想”，存档封存，不再反复琢磨。","x":-3183,"y":7894,"width":667,"height":53},
		{"id":"1e9480b328acb7b4","type":"text","text":"对外做功，","x":-3117,"y":8556,"width":199,"height":50},
		{"id":"38a19e53c9f9381b","type":"text","text":"先动起来而不是先变完美","x":-2731,"y":8674,"width":250,"height":60},
		{"id":"2466ba23ba25600e","type":"text","text":"动手做事","x":-2757,"y":8566,"width":120,"height":50},
		{"id":"40404e2296b500b2","type":"text","text":"一动手做事，大脑就被迫从 “缺陷扫描模式” 切换到 ==“问题解决模式”==，那个无时无刻的警惕会暂时停掉","x":-2437,"y":8566,"width":352,"height":93},
		{"id":"261cec539bcab876","type":"text","text":"这个想法是颠覆性的","x":-3785,"y":7609,"width":250,"height":60},
		{"id":"76506be18788b415","type":"text","text":"靠 “不满 - 自我攻击 - 逼自己” 实现","x":-4006,"y":8840,"width":305,"height":60},
		{"id":"1da1f37cca0fadce","type":"text","text":"能不能试试正向呢","x":-3560,"y":8845,"width":250,"height":60},
		{"id":"c3a9ec8895f7447a","type":"text","text":"每天都在沉浸在自己的不足中","x":-4022,"y":8034,"width":260,"height":61},
		{"id":"9576f1b6c25682e3","type":"text","text":"想法只是行动的草稿","x":-3753,"y":7947,"width":203,"height":50},
		{"id":"cc4e9b71545f6f75","type":"text","text":"# ==稀释内耗==","x":-3865,"y":8563,"width":164,"height":50},
		{"id":"ff562d6ca3559d5f","type":"text","text":"这个想法是万能的","x":-3800,"y":7841,"width":250,"height":60},
		{"id":"32c38e82ce9452c3","type":"text","text":"**只有保持紧张、保持思考、保持自我苛责，我才是在进步、才是安全的**。一旦停下来放松，你反而会产生 “我是不是在荒废、会不会被淘汰” 的深层恐慌，于是主动回到内耗里。","x":-3117,"y":8224,"width":689,"height":50},
		{"id":"e1c3221a543ebe40","type":"text","text":"把评判标准从 “这个想法够不够厉害”，换成 “这件小事能不能先做了”。比如想做一个项目，不要反复推演模式靠不靠谱，先花 1 小时把同行的情况摸一遍；想搞一个副业，不要想能不能赚大钱，先把第一个产品上架。","x":-3148,"y":7984,"width":632,"height":81},
		{"id":"f3947896f3f3e50d","type":"text","text":"本质：想法一旦落地，就从 “压在你心上的重担”，变成了 “你手里的工具”。它不再需要是完美的、万能的，只要能用就行。","x":-3163,"y":8089,"width":647,"height":56},
		{"id":"0aaf9a7cd07394f7","type":"text","text":"心灰意冷，","x":-1492,"y":5596,"width":192,"height":50},
		{"id":"f30d4cd3a7ec8015","type":"text","text":"觉得自己不值得","x":-1065,"y":5586,"width":223,"height":50},
		{"id":"24c7f4e0a54cfcf8","type":"text","text":"区别对待","x":-1602,"y":5300,"width":250,"height":60},
		{"id":"30b6de0639473a0e","type":"text","text":"得不到重视","x":-1998,"y":5311,"width":177,"height":50},
		{"id":"a1e8ccb72bd38152","type":"text","text":"这个想法是创造性的，","x":-3781,"y":7498,"width":250,"height":60},
		{"id":"0edfcaf91f5a2ce2","type":"text","text":"用完就扔","x":-3454,"y":7947,"width":158,"height":55},
		{"id":"ce888b68008e6fa5","type":"text","text":"时间久了，反而爱上了这种让自己难受的内耗了。“我在努力” 的证明","x":-3634,"y":8224,"width":418,"height":50},
		{"id":"9dfdb14fee713892","type":"text","text":"想法只是==行动的草稿==、用完就扔的==工具==","x":-3552,"y":8553,"width":250,"height":60},
		{"id":"aa6fd11275aeed55","type":"text","text":"放弃","x":-2788,"y":5436,"width":83,"height":50},
		{"id":"a2149065f119377d","type":"text","text":"好孩子","x":-1880,"y":4540,"width":97,"height":50},
		{"id":"23728b71caf147c1","type":"text","text":"维护自己的人设","x":-1978,"y":4420,"width":250,"height":60},
		{"id":"5390f3bd93ee22cc","type":"text","text":"被困在这个框架里边","x":-1602,"y":4420,"width":250,"height":60},
		{"id":"8e2a83a0081b84b5","type":"text","text":"没有耐心，快","x":-1760,"y":4540,"width":158,"height":50},
		{"id":"e75fcfb0a69f8823","type":"text","text":"解决问题，进步","x":-2408,"y":4310,"width":169,"height":60},
		{"id":"81d9f30e152d8d8f","type":"text","text":"有钱","x":-2139,"y":4540,"width":91,"height":50},
		{"id":"de40c8f89acfc686","type":"text","text":"听话","x":-2020,"y":4540,"width":117,"height":50},
		{"id":"4ddc5154e43b3498","type":"text","text":"表现自己","x":-2389,"y":4420,"width":250,"height":60,"color":"2"},
		{"id":"9faa670bd73ed30d","type":"text","text":"被人放弃","x":-2453,"y":5316,"width":250,"height":60},
		{"id":"f5b49a3aadbe5258","type":"text","text":"自我怀疑","x":-2453,"y":5606,"width":250,"height":60},
		{"id":"ab93537c6b2957ea","type":"file","file":"Pasted image 20260920084330.png","x":-1904,"y":3780,"width":854,"height":50},
		{"id":"9b8d0ea768a27a1d","type":"text","text":"一切都是徒劳的，无所谓的，虚伪的","x":-3001,"y":6166,"width":312,"height":50},
		{"id":"ea96764fe099e29d","type":"text","text":"尊卑有序","x":-2730,"y":6226,"width":179,"height":60},
		{"id":"42ac2e94e470ba01","type":"file","file":"Pasted image 20260920084005.png","x":-2725,"y":3885,"width":76,"height":50},
