		{"id":"7a9ecb38110d1086","type":"file","file":"Pasted image 20260919191709.png","x":-2440,"y":3910,"width":413,"height":50},
		{"id":"4274613a27545d95","type":"text","text":"逃避痛苦，摆烂了","x":-2405,"y":4170,"width":185,"height":60},
		{"id":"daf3fd46c7c3fa78","type":"file","file":"Pasted image 20260919191647.png","x":-2419,"y":3780,"width":329,"height":50},
		{"id":"4434a05d036415e2","type":"text","text":"依附、盲从、阶级","x":-2880,"y":6434,"width":250,"height":60},
		{"id":"6c5764978416c186","type":"text","text":"否定一切","x":-2907,"y":6284,"width":124,"height":50},
		{"id":"3f0a73abf9b5a928","type":"text","text":"死亡","x":-2903,"y":6066,"width":115,"height":50},
		{"id":"f5d1183ef9004df9","type":"text","text":"秩序","x":-2658,"y":5880,"width":107,"height":50},
		{"id":"e91a0252855085ba","type":"text","text":"长幼有序、人格高低","x":-2433,"y":6274,"width":250,"height":60},
		{"id":"afd31f012bf78b7e","type":"text","text":"和别人的对比","x":-2183,"y":5993,"width":143,"height":57},
		{"id":"8af28f1541aa2762","type":"text","text":"三六九等","x":-2423,"y":6000,"width":125,"height":50},
		{"id":"c6884183ff7058e7","type":"text","text":"期望得到反馈：习惯等着长辈、权威、重要的人","x":-2420,"y":6483,"width":309,"height":54},
		{"id":"b1a4cf51a78daa1b","type":"text","text":"能力、收入、职位去划分人的高低等级","x":-2339,"y":6152,"width":328,"height":50},
		{"id":"6fdab3eb7004771d","type":"text","text":"评价","x":-3447,"y":3135,"width":97,"height":50,"color":"1"},
		{"id":"7205b5da8818f197","type":"text","text":"随波逐流","x":-3496,"y":3225,"width":121,"height":50},
		{"id":"7f712d8b670ed31b","type":"text","text":"被驯化","x":-3180,"y":2120,"width":104,"height":60},
		{"id":"aff2f66b2c747aee","type":"text","text":"方便管理","x":-3239,"y":2300,"width":111,"height":50},
		{"id":"e360c2689318f5e7","type":"text","text":"这个想法是扭转乾坤的","x":-3762,"y":7763,"width":250,"height":60},
		{"id":"e9ae6033a2b2a2b0","type":"text","text":"现状","x":-3660,"y":2969,"width":80,"height":50},
		{"id":"6d54ac3f56d2666c","type":"file","file":"Pasted image 20260918092359.png","x":-3748,"y":3500,"width":797,"height":50},
		{"id":"02a3869751e9905b","type":"text","text":"学习、模仿","x":-3444,"y":3312,"width":129,"height":50},
		{"id":"4854ca0355680709","type":"text","text":"不骄不躁，成熟的标志","x":-3239,"y":2816,"width":250,"height":60},
		{"id":"21763f2b8167701a","type":"text","text":"自卑","x":-3399,"y":2802,"width":85,"height":50},
		{"id":"1c768e62d944c019","type":"text","text":"努力不够","x":-3463,"y":2994,"width":128,"height":50},
		{"id":"7ab82550a65f7b85","type":"text","text":"统一度量衡","x":-3195,"y":5994,"width":152,"height":56},
		{"id":"dd6b2662379c8c1b","type":"text","text":"唯一、不变、宏大真理","x":-3222,"y":6126,"width":207,"height":50},
		{"id":"12324da7a382d2e4","type":"text","text":"衡量人、分出高低对错","x":-3244,"y":6226,"width":250,"height":60},
		{"id":"e6ae64a9b8419cee","type":"text","text":"无时无刻都在警惕中","x":-4463,"y":8481,"width":250,"height":60},
		{"id":"b4e794262c420966","type":"text","text":"描述：所有的不满、焦虑、渴望，全部汇入「改变」这个总阀门，而这个阀门只通向「改变自己」这唯一一条路；==这条路的终点又不是行动，而是反复的自我审视和空想==，最终能量全部在内部撞墙、反弹、内耗，越转越紧，紧到心脏发沉、时刻警惕。","x":-5763,"y":8249,"width":227,"height":292},
		{"id":"0e1b93ebf00956c3","type":"text","text":"这就是你时刻紧绷的根源 —— 你相当于在要求自己：**在不换环境、不换规则、不换人群的前提下，只靠压榨自己，就实现破局**。这难度太大了，大到你必须时刻警惕、时刻逼自己，都还觉得不够。","x":-5663,"y":8637,"width":250,"height":223},
		{"id":"b58ae71260c1bf08","type":"text","text":"心里层面的内在焦虑","x":-5536,"y":7691,"width":250,"height":60},
		{"id":"bb8e8323240e0c6b","type":"text","text":"想被认可","x":-5878,"y":7588,"width":250,"height":60},
		{"id":"4e7c3bc1f5d1c6c9","type":"text","text":"自己","x":-5002,"y":8064,"width":250,"height":60},
		{"id":"9472f743937b546f","type":"text","text":"2/3","x":-4485,"y":7250,"width":97,"height":50},
		{"id":"c9bece5c8f9cd2bb","type":"text","text":"不满 ","x":-5615,"y":7280,"width":250,"height":60},
		{"id":"5375bbdcd9e75a7a","type":"text","text":"现实层面","x":-5320,"y":7395,"width":162,"height":50},
		{"id":"1d59b6b4c855c3ac","type":"text","text":"改变","x":-5158,"y":7628,"width":156,"height":50},
		{"id":"e124e118017a1078","type":"text","text":"每天产出一个最小行动","x":-4068,"y":7947,"width":212,"height":50},
		{"id":"5f4316b3afd988e5","type":"text","text":"记住：你不需要在不适合你的环境里，把自己拧成符合别人标准的人；你可以找一个你本来的样子就被需要、就能变现的环境。","x":-4260,"y":7356,"width":729,"height":64},
		{"id":"5ed3091d2b2e600a","type":"text","text":"每天都需要有种感觉就是像是==大锤重击==的我心脏一样","x":-4427,"y":8280,"width":459,"height":63},
		{"id":"09ccd9756a26c8c1","type":"text","text":"每天都在思考一个想法","x":-4388,"y":7528,"width":250,"height":60},
		{"id":"92a6c60f6623bcd6","type":"text","text":"不满 → 改变 → 只能改变自己（外界直接放弃）","x":-5960,"y":8636,"width":250,"height":60},
		{"id":"e0da77cee6011d82","type":"text","text":"想达到别人的标准，严格的要求自己","x":-5951,"y":7701,"width":323,"height":50},
		{"id":"7e8515633f01fec7","type":"text","text":"可以筛选环境、选择关系的小空间","x":-3971,"y":7104,"width":250,"height":60},
		{"id":"323e86efc49a40b7","type":"text","text":"事有轻重缓急","x":-3802,"y":1842,"width":250,"height":60},
		{"id":"93bbfe0aaf5b6df5","type":"text","text":"表现自己","x":-4266,"y":1659,"width":146,"height":50},
		{"id":"78202da38dfe4a33","type":"text","text":"对事","x":-3806,"y":1657,"width":250,"height":60},
		{"id":"629854ea0d009ebf","type":"text","text":"维护自己的人设","x":-4321,"y":1806,"width":250,"height":60},
		{"id":"d3c813401d1c847e","type":"text","text":"头疼","x":-4380,"y":2969,"width":58,"height":50},
		{"id":"a046b8a001fd8a23","type":"text","text":"一个道理，一个思想，一种认知","x":-4373,"y":3114,"width":250,"height":60},
		{"id":"9db9ea528e7d6e69","type":"text","text":"害怕落后，因为落后就会挨打","x":-5995,"y":7845,"width":288,"height":50},
		{"id":"6a287db1a2ed888f","type":"text","text":"进步","x":-4494,"y":8840,"width":250,"height":60},
		{"id":"20f884e6fbf7f015","type":"text","text":"被困在这个框架里边","x":-4318,"y":1982,"width":250,"height":60},
		{"id":"68f0a1791ad9daae","type":"text","text":"思维开关","x":-4060,"y":2969,"width":120,"height":50},
		{"id":"7229a6d8a0bee781","type":"text","text":"我总是想在这条路上跑的更快更远，从来没有想过这条路对不对，适不适合自己","x":-3990,"y":3216,"width":370,"height":73},
		{"id":"6b282b265f34dae6","type":"text","text":"不用去说服任何人、改变任何人，但你可以列一张「环境变量清单」：当前能换的赛道、能接触的新圈子、能调整的工作内容、能主动砍掉的消耗性关系。","x":-4289,"y":7212,"width":739,"height":50},
		{"id":"54889d04162c15e2","type":"text","text":"把你每天用来琢磨 “我哪里还不够好” 的精力，拿出一半来琢磨：**我能换个什么地方 / 什么事，能让我现有的优点直接值钱**。","x":-4262,"y":7273,"width":727,"height":67},
		{"id":"413a7dbcc93b88b5","type":"text","text":"成功只是一个结果、而过程才是选择","x":-3092,"y":2030,"width":250,"height":60},
		{"id":"bf86da0e2cd484ca","type":"text","text":"被要求成熟","x":-3076,"y":2300,"width":132,"height":50},
		{"id":"c1a4c2b5b8c60624","type":"text","text":"身体","x":-4063,"y":2813,"width":123,"height":63},
		{"id":"5c26a2a440a23983","type":"text","text":"想要得到","x":-3800,"y":2657,"width":122,"height":50},
		{"id":"6269cda42f32529c","type":"text","text":"被在乎，被尊重，被认可的感觉","x":-3865,"y":2510,"width":250,"height":60},
		{"id":"a4b52ff6c058581f","type":"text","text":"谦逊（做的不够好）","x":-3482,"y":2657,"width":191,"height":50},
		{"id":"16dc72aee5b6dd1d","type":"text","text":"进步","x":-3532,"y":2777,"width":82,"height":50},
		{"id":"1f35f5773a8f6f9b","type":"text","text":"否定自己","x":-3473,"y":2494,"width":123,"height":60},
		{"id":"b7c83ca12172df8b","type":"text","text":"从来没有想过改变别人，改变环境","x":-4463,"y":7100,"width":250,"height":60},
		{"id":"c3a0d8c679def4a8","type":"text","text":"现状","x":-5750,"y":7160,"width":89,"height":50},
		{"id":"ce9956e56482e41a","type":"text","text":"外界","x":-4943,"y":7100,"width":250,"height":60},
		{"id":"d571bf1db19feee4","type":"text","text":"高风险","x":-880,"y":13818,"width":250,"height":60},
		{"id":"d52f85eff08f2f07","type":"text","text":"不敢努力害怕一努力别人就看出他天赋不高的虚荣内心就昭然若揭了。","x":-120,"y":12160,"width":588,"height":50},
		{"id":"389ab1f3ac708cbc","type":"text","text":"瞧你这话说的同样是人，习近平还是国家领导人呢 你为啥不行","x":2469,"y":13581,"width":326,"height":92},
		{"id":"154d3d1a5cd30116","type":"text","text":"红河水，浪打浪","x":2900,"y":14069,"width":250,"height":60},
		{"id":"436db072e00a8bc6","type":"text","text":"我喜欢吃亏，不需要你来教我","x":2586,"y":13240,"width":250,"height":60},
		{"id":"ed6ed21bc8a114fd","type":"text","text":"我不接受你的建议，你总不能强迫我吧","x":2590,"y":13361,"width":250,"height":60},
		{"id":"320431447a149bdc","type":"text","text":"你的规则是你的规则，我的规则是我的柜子","x":-2308,"y":1320,"width":353,"height":53},
		{"id":"645dec289fee69be","type":"text","text":"赚钱太少了","x":-6020,"y":7160,"width":127,"height":50},
		{"id":"952ec8fc2d118a09","type":"text","text":"质疑自己","x":-140,"y":12000,"width":250,"height":60},
		{"id":"23a732aa1073a20c","type":"text","text":"自己","x":-402,"y":12162,"width":102,"height":58},
		{"id":"ebae8105292c82fe","type":"text","text":"许昕嘛，从他这么多年的赛场表现来看，他就是那种关键时刻指望不上他的人，小赛公开赛之类的还能指望他顶一顶，真到了大赛上，世乒赛、奥运会，给他多大压力，他就能捅多大篓子。再结合他赛场下种种不深刻反省、轻浮的言行，那种不敢努力害怕一努力别人就看出他天赋不高的虚荣内心就昭然若揭了。 作者：gracieldt 链接：https://www.zhihu.com/question/26562462/answer/2032825385751196619 来源：知乎 著作权归作者所有。商业转载请联系作者获得授权，非商业转载请注明出处。","x":-390,"y":12720,"width":250,"height":308},
		{"id":"445d279d8f60f42b","type":"text","text":"紧张、怯懦","x":-814,"y":12353,"width":134,"height":50},
		{"id":"3723213a07ffc0e7","type":"text","text":"高薪产业，哪个不是互联网，雷军不是吗？","x":2720,"y":12617,"width":250,"height":60},
		{"id":"3d73108ed93a5aad","type":"text","text":"这句话也只是体现自己优越感的一句话","x":2545,"y":12444,"width":250,"height":60},
		{"id":"adacbfce79c8d0aa","type":"text","text":"自己是不是也是在通过否抵挡自己来找到优越感呢","x":2260,"y":12617,"width":250,"height":60},
		{"id":"443494868ea4d21e","type":"text","text":"而是咱俩、的肩膀般般起（老习来了也得平等对话）","x":-701,"y":6532,"width":250,"height":60,"color":"1"},
		{"id":"84554b0dff55eadc","type":"text","text":"而不是尊卑臣服","x":-701,"y":6274,"width":250,"height":60},
		{"id":"6c7388c1b6d63a0b","type":"text","text":"更不是贬低自己，抬高他人","x":-701,"y":6420,"width":250,"height":60},
		{"id":"8f60832cc5bb5cf0","type":"text","text":"价值","x":130,"y":6141,"width":86,"height":50},
		{"id":"4ecae38b60b6a19c","type":"text","text":"分工、能力等差别，但是人格平等，无需仰视，俯视","x":-701,"y":6640,"width":250,"height":60,"color":"1"},
		{"id":"6d21c051949d8326","type":"text","text":"我自己定义","x":347,"y":6238,"width":148,"height":61},
		{"id":"6807023ac0338d37","type":"text","text":"一点进步，就应该开心","x":910,"y":6450,"width":209,"height":50},
		{"id":"557a3f432379760e","type":"text","text":"我值的","x":363,"y":6427,"width":116,"height":50},
		{"id":"322edace98a341dd","type":"text","text":"保尔柯察金","x":1279,"y":6091,"width":139,"height":50},
		{"id":"eb5abb39da55662c","type":"text","text":"新秩序","x":-651,"y":5880,"width":250,"height":60},
		{"id":"a04ecc1c86386356","type":"text","text":"不配","x":-638,"y":5571,"width":147,"height":50},
		{"id":"b5fa4b27f93533c0","type":"file","file":"Pasted image 20260914114031.png","x":-499,"y":520,"width":1321,"height":50},
